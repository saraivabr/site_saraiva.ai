{
  "name": "saraiva-ai-site",
  "version": "2.0.0",
  "private": true,
  "description": "Site editorial e catálogo público da Saraiva.AI",
  "author": "Saraiva.AI",
  "license": "MIT",
  "homepage": "https://saraiva.ai",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "mkdir -p .next/standalone/.next && cp -R .next/static .next/standalone/.next/static && cp -R public .next/standalone/public",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "migrate:catalog": "node scripts/migrate-public-catalog.mjs",
    "migrate:assets": "node scripts/migrate-public-assets.mjs",
    "sync:offers": "node scripts/sync-airtable-offers.mjs",
    "motion:studio": "remotion studio src/remotion/index.ts",
    "motion:render": "remotion render src/remotion/index.ts SaraivaSignalStory output/saraiva-signal-story.mp4"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "lucide-react": "^1.6.0",
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.509",
    "@remotion/studio": "4.0.509",
    "@tailwindcss/postcss": "^4",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "remotion": "4.0.509",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
